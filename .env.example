# Comma-separated list of Groq API keys (supports 1 to 8+ keys for high-throughput rotation)
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5,gsk_key6,gsk_key7,gsk_key8

# Models (Optional overrides)
WHISPER_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile
FAST_LLM_MODEL=llama-3.1-8b-instant
REASONING_MODEL=deepseek-r1-distill-llama-70b
